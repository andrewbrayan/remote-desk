# API / web login
PORT=8787
WEB_USERNAME=admin
WEB_PASSWORD=change-this-now
JWT_SECRET=replace-with-a-long-random-string

# Shared only with the Windows agent
AGENT_TOKEN=replace-with-another-long-random-string

# JSON. Add your TURN server for reliable connections outside the LAN.
RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Windows agent (set these on the Windows PC)
API_URL=http://localhost:8787
